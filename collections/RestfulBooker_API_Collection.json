        },
        {
          "name": "Request 2 - Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Tạo booking thành công (Status 200)\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const jsonData = pm.response.json();\r",
                  "const expectedFirstName = pm.variables.get(\"firstname\");\r",
                  "\r",
                  "pm.test(\"Tên khách hàng khớp dữ liệu đầu vào\", function () {\r",
                  "    pm.expect(jsonData.booking.firstname).to.eql(expectedFirstName);\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"bookingid\", jsonData.bookingid);\r",
                  "\r",
                  "console.log(\"Booking ID:\", jsonData.bookingid);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const customers = [\r",
                  "    {\r",
                  "        firstname: \"Nguyen\",\r",
                  "        lastname: \"An\",\r",
                  "        totalprice: 1500,\r",
                  "        depositpaid: true,\r",
                  "        checkin: \"2026-11-01\",\r",
                  "        checkout: \"2026-11-05\",\r",
                  "        additionalneeds: \"Breakfast\"\r",
                  "    },\r",
                  "    {\r",
                  "        firstname: \"Tran\",\r",
                  "        lastname: \"Binh\",\r",
                  "        totalprice: 800,\r",
                  "        depositpaid: false,\r",
                  "        checkin: \"2026-11-10\",\r",
                  "        checkout: \"2026-11-12\",\r",
                  "        additionalneeds: \"Extra Pillow\"\r",
                  "    },\r",
                  "    {\r",
                  "        firstname: \"Le\",\r",
                  "        lastname: \"Chi\",\r",
                  "        totalprice: 2500,\r",
                  "        depositpaid: true,\r",
                  "        checkin: \"2026-12-01\",\r",
                  "        checkout: \"2026-12-10\",\r",
                  "        additionalneeds: \"Late Checkout\"\r",
                  "    }\r",
                  "];\r",
                  "\r",
                  "const index = Number.isInteger(pm.info.iteration)\r",
                  "    ? pm.info.iteration % customers.length\r",
                  "    : 0;\r",
                  "\r",
                  "const customer = customers[index];\r",
                  "\r",
                  "Object.keys(customer).forEach(function (key) {\r",
                  "    pm.variables.set(key, customer[key]);\r",
                  "});\r",
                  "\r",
                  "console.log(\"Khách hàng đang kiểm thử:\", customer.firstname, customer.lastname);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"firstname\": \"{{firstname}}\",\r\n    \"lastname\": \"{{lastname}}\",\r\n    \"totalprice\": {{totalprice}},\r\n    \"depositpaid\": {{depositpaid}},\r\n    \"bookingdates\": {\r\n        \"checkin\": \"{{checkin}}\",\r\n        \"checkout\": \"{{checkout}}\"\r\n    },\r\n    \"additionalneeds\": \"{{additionalneeds}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://restful-booker.herokuapp.com/booking",
              "protocol": "https",
              "host": [
                "restful-booker",
                "herokuapp",
                "com"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
